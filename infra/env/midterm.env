# Midterm deployment runtime defaults.
#
# This is the deployment env file for the midterm project version.
# It opts into stricter pose/face thresholds and Savant ingress FPS control.

FACE_OBSERVATION_EXPORT_ENABLED=true
FACE_REID_MIN_INTERVAL_MS=1000
FACE_REID_MIN_CONFIDENCE=0.45
FACE_REID_MIN_FACE_SIZE=40
FACE_REID_NORM_TOLERANCE=0.10
FACE_CONFIDENCE_THRESHOLD=0.50

PERSON_OBSERVATION_EXPORT_ENABLED=true
PERSON_OBSERVATION_STREAM=security.person_observations
PERSON_BBOX_OBSERVATION_MIN_INTERVAL_MS=333
PERSON_OBSERVATION_MIN_INTERVAL_MS=333
PERSON_OBSERVATION_BATCH_SIZE=100
PERSON_OBSERVATION_WORKER_BATCH_SIZE=500
PERSON_OBSERVATION_MAXLEN=100000

SAVANT_REDIS_EXPORTER_SOCKET_TIMEOUT_MS=500
SAVANT_REDIS_EXPORTER_CONNECT_TIMEOUT_MS=500
SAVANT_REDIS_EXPORTER_QUEUE_MAXSIZE=8192
SAVANT_REDIS_EXPORTER_WRITE_RETRIES=10
SAVANT_REDIS_EXPORTER_RETRY_SLEEP_MS=20

FORWARDER_QUEUE_MAX_SIZE=2048
FORWARDER_SEND_TIMEOUT_MS=2000
FORWARDER_SEND_RETRIES=3
FORWARDER_SEND_HWM=1000

FRAME_ANNOTATION_EXPORT_ENABLED=true
FRAME_ANNOTATION_STREAM=security.frame_annotations
FRAME_ANNOTATION_TTL_SECONDS=600
FRAME_ANNOTATION_MAX_OBJECTS_PER_FRAME=100
FRAME_ANNOTATION_INCLUDE_KEYPOINTS=compact
FRAME_ANNOTATION_INCLUDE_LANDMARKS=compact
FRAME_ANNOTATION_INCLUDE_EMBEDDING=false
FRAME_ANNOTATION_REDIS_MAXLEN=200000
FRAME_ANNOTATION_SOURCE_STREAM_ENABLED=false
FRAME_ANNOTATION_SOURCE_STREAM_PATTERN=security.frame_annotations.__source_id__
FRAME_ANNOTATION_STREAM_MODE=global
FRAME_ANNOTATION_SOURCE_REDIS_MAXLEN=5000
FRAME_ANNOTATION_WRITE_TIMEOUT_MS=500
FRAME_ANNOTATION_REDIS_QUEUE_MAXSIZE=8192
FRAME_ANNOTATION_LOG_EVERY_N=300
FRAME_ANNOTATION_EXPORT_MIN_INTERVAL_MS=0
STREAM_SESSION_PTS_ROLLBACK_TOLERANCE_NS=5000000000
POST_SAVANT_FRAME_PROOF_ATTEMPTS=1
# Legacy compatibility knob; effective polling is bounded by the budget below.
POST_SAVANT_FRAME_PROOF_RETRY_SLEEP_S=1.0
POST_SAVANT_FRAME_PROOF_WAIT_BUDGET_S=3
POST_SAVANT_FRAME_PROOF_POLL_INTERVAL_S=0.5
POST_SAVANT_FRAME_PROOF_FAST_PATH_BATCH_SIZE=0
POST_SAVANT_FRAME_PROOF_FAST_PATH_LAG=0
POST_SAVANT_FRAME_PROOF_FAST_PATH_PENDING=0
CLIP_WORKER_FRAME_ANNOTATION_LOOKUP_CONCURRENCY=8
CLIP_WORKER_FRAME_ANNOTATION_RANGE_CACHE_TTL_S=0.75
CLIP_WORKER_FRAME_ANNOTATION_RANGE_CACHE_BUCKET_MS=1000
CLIP_WORKER_FRAME_ANNOTATION_RANGE_CACHE_MAX_ENTRIES=64
POST_SAVANT_ALLOW_CROSS_SESSION_POST_WINDOW_PROOF=true
POST_SAVANT_ALLOW_TRUNCATED_PRE_WINDOW_PROOF=true
FRAME_ANNOTATION_ANCHOR_LOOKBACK_COUNT=20000
FRAME_ANNOTATION_ANCHOR_PAGE_COUNT=2000

MAX_FPS_CONTROL=false
INGRESS_FPS_GATE_ENABLED=true
MAX_FPS=8/1
MIN_FPS=2/1
BATCH_SIZE=4
POSE_BATCH_SIZE=4
FACE_DETECTOR_BATCH_SIZE=4
FACE_EMBEDDING_BATCH_SIZE=16
POSE_MODEL_FILE=/models/yolo26_pose/yolo26_pose.dynamic.raw56.onnx
POSE_DECODER_LAYOUT=decoded_56
FACE_DETECTOR_MODEL_FILE=/models/yolov8_face/yolov8n-face.dynamic.onnx
MAX_PARALLEL_STREAMS=64
BATCHED_PUSH_TIMEOUT=40000
WEBSERVER_PORT=8080
METRICS_FRAME_PERIOD=1000
METRICS_TIME_PERIOD=5
METRICS_HISTORY=100
METRICS_EXTRA_LABELS={"service":"savant-security","profile":"midterm"}
POSE_INFER_INTERVAL=1
POSE_CONFIDENCE_THRESHOLD=0.60
POSE_KEYPOINT_THRESHOLD=0.35
POSE_FORCE_NMS=true
POSE_SELECTOR_CONFIDENCE_THRESHOLD=0.60
POSE_SELECTOR_NMS_IOU_THRESHOLD=0.50
POSE_MIN_WIDTH=60
POSE_MIN_HEIGHT=100
POSE_COORDINATE_RESTORE_MODE=letterbox
POSE_CONVERTER_DEBUG_DUMP_ENABLED=false
SAVANT_PERF_METRICS_ENABLED=true
SAVANT_PERF_METRICS_STAGE_RATES_ENABLED=true
SAVANT_PERF_METRICS_FPS_WINDOW_S=10

# DeepStream nvinfer interval skips N frames and infers every N+1 frames.
# With the midterm 8 FPS ingress cap, 7 keeps YOLOv8-Face and AdaFace near 1 FPS.
FACE_INFER_INTERVAL=7
FACE_EMBEDDING_INFER_INTERVAL=7

STORAGE_MAINTENANCE_SUMMARY_ENABLED=true
STORAGE_MAINTENANCE_PREVIEW_ENABLED=true
STORAGE_MAINTENANCE_EXECUTE_ENABLED=true

RECORDING_EVENT_TYPES=watchlist_hit,intrusion
RECORDING_MAX_REQUESTS_PER_RUN=0
RECORDING_COOLDOWN_SECONDS=30
RECORDING_COOLDOWN_SCOPE=algorithm
RECORDING_COOLDOWN_GRACE_MS=1000
EVIDENCE_MATERIALIZATION_POLICY=priority
EVIDENCE_HIGH_PRIORITY_EVENT_TYPES=watchlist_hit,live_search_hit
EVIDENCE_MATERIALIZATION_DEFER_LOW_PRIORITY=false
EVIDENCE_REPLAY_TTL_SECONDS=300
EVIDENCE_FRAME_ANNOTATION_TTL_SECONDS=600
EVIDENCE_UNKNOWN_SOURCE_FAIL_CLOSED=true
# MAX_ACTIVE_GLOBAL / _BY_EVENT_TYPE are durable-backlog guards: past the cap a
# new task is written as materialization_skipped and no evidence is produced.
# The cap is first-come-first-served on its own, so a chatty camera can fill it
# with backlog and quiet cameras are refused at admission -- where scheduler
# fairness cannot help, because the task was never enqueued.
EVIDENCE_ADMISSION_MAX_ACTIVE_GLOBAL=240
# RESERVED_PER_SOURCE gives every listed source a floor of outstanding tasks
# that no other source can consume; the rest of the global cap is a shared pool
# a busy source may exhaust. Requires the roster below -- without it the shared
# remainder cannot be sized and the reservation stays off. One evidence task is
# one event's request (evidence_tasks is keyed by event_id), so a floor of 1 is
# one complete event.
EVIDENCE_ADMISSION_RESERVED_PER_SOURCE=1
# Enabled sources, not "sources with backlog": a camera that is quiet right now
# is exactly the one the floor exists for. Set to the deployment's source ids.
EVIDENCE_ADMISSION_RESERVED_SOURCES=
# Per-source is an execution-concurrency bound, not a backlog guard. The task
# still enters the queue; MEDIA_WORKER_SOURCE_MAX_ACTIVE limits how many of a
# camera's tasks run at once. Set SOURCE_LIMIT_MODE=skip to restore the old
# drop-on-cap behaviour.
EVIDENCE_ADMISSION_MAX_ACTIVE_PER_SOURCE=1
EVIDENCE_ADMISSION_SOURCE_LIMIT_MODE=execution_concurrency
EVIDENCE_ADMISSION_MAX_ACTIVE_BY_EVENT_TYPE=intrusion:40
EVIDENCE_MATERIALIZATION_MAX_CONCURRENCY=36
EVIDENCE_MATERIALIZATION_MAX_CONCURRENCY_PER_SHARD=9
EVIDENCE_MATERIALIZATION_MAX_CONCURRENCY_PER_SOURCE=1
EVIDENCE_REPLAY_ACTIVE_SLOT_EXTRA_SECONDS=0
EVIDENCE_REPLAY_SLOT_SINK_STABILITY_BUDGET_S=60
EVIDENCE_REPLAY_SLOT_FINALIZER_BUDGET_S=0
EVIDENCE_REPLAY_SLOT_GRACE_S=5
EVIDENCE_MATERIALIZATION_EVENT_TYPE_QUOTAS=
EVIDENCE_DENSITY_PROFILE=normal
EVIDENCE_MATERIALIZATION_PRESSURE_LEVEL=normal
MEDIA_POLL_INTERVAL_S=2
MEDIA_WORKER_CLEANUP_RECOVERY_POLL_INTERVAL_S=30
MIDTERM_SINK_STABILITY_CHECKS=2
DEFAULT_PRE_SECONDS=5
DEFAULT_POST_SECONDS=5
RECORDING_PRE_SECONDS=5
RECORDING_POST_SECONDS=5
CLIP_WORKER_MAX_JOBS_PER_RUN=100
CLIP_WORKER_RUN_ONCE=false
CLIP_WORKER_CONSUMER_COUNT=8
CLIP_WORKER_MAX_CONCURRENT_JOBS=8
CLIP_WORKER_PENDING_CLAIM_MIN_IDLE_MS=5000
CLIP_WORKER_PENDING_CLAIM_COUNT=10
CLIP_WORKER_PENDING_CLAIM_INTERVAL_S=5
CLIP_WORKER_DEFERRED_RETRY_MAX_ATTEMPTS=12
CLIP_WORKER_PER_CAMERA_COOLDOWN_SECONDS=0

MEDIA_WORKER_STATE_PATH=/media/replay-sink-output/midterm/.media-worker.processed.json
MEDIA_SINK_SCAN_MAX_METADATA_FILES=20000
MEDIA_PROBE_TIMEOUT_S=30
MEDIA_DECODE_TIMEOUT_S=120
MEDIA_WORKER_MATERIALIZATION_MAX_ACTIVE=4
MEDIA_WORKER_MATERIALIZATION_TIMEOUT_S=180
MEDIA_WORKER_MATERIALIZATION_MAX_BACKLOG=200
MEDIA_WORKER_MATERIALIZATION_MAX_PER_POLL=0
MEDIA_WORKER_IMAGE_WORKERS=4
MEDIA_WORKER_IMAGE_QUEUE_CAPACITY=4
MEDIA_WORKER_REMUX_QUEUE_CAPACITY=4
MEDIA_WORKER_FINALIZER_WORKERS=32
MEDIA_WORKER_FINALIZER_PROCESS_WORKERS=0
MEDIA_WORKER_FINALIZER_QUEUE_CAPACITY=4
MEDIA_WORKER_FINALIZER_MAX_PER_SOURCE_PER_POLL=4
MEDIA_WORKER_FINALIZER_SOURCE_SERIAL=false
MEDIA_WORKER_SOURCE_MAX_ACTIVE=4
MEDIA_WORKER_RESERVED_NON_IMAGE=1
MEDIA_WORKER_SINGLE_FINALIZER_V2_ENABLED=true
MEDIA_WORKER_SCHEDULER_V2_ENABLED=true
MEDIA_WORKER_DB_POOL_ENABLED=true
MEDIA_WORKER_DB_POOL_TIMEOUT_S=5
MEDIA_WORKER_DB_INDEX_IO_CONCURRENCY=0
MEDIA_WORKER_SEGMENT_INDEX_ENABLED=true
MEDIA_WORKER_SEGMENT_INDEX_REFRESH_INTERVAL_S=0.5
MEDIA_WORKER_SEGMENT_INDEX_RECONCILE_INTERVAL_S=30
MEDIA_WORKER_SEGMENT_INDEX_STABILITY_AGE_S=0.25
MEDIA_WORKER_SEGMENT_INDEX_ROW_CACHE_ENTRIES=256
MEDIA_WORKER_SEGMENT_INDEX_ROW_CACHE_MAX_BYTES=268435456
MEDIA_WORKER_SEGMENT_INDEX_IO_CONCURRENCY=2
MEDIA_WORKER_SEGMENT_INDEX_MAX_CATALOGS=256
MEDIA_WORKER_SHUTDOWN_GRACE_S=45
MEDIA_WORKER_SHUTDOWN_KILL_TIMEOUT_S=5
MEDIA_WORKER_LEASE_HEARTBEAT_INTERVAL_S=10
MEDIA_WORKER_MAX_ATTEMPT_AGE_S=300
MEDIA_WORKER_MATERIALIZATION_THROTTLE_SLEEP_S=0
MEDIA_WORKER_MATERIALIZATION_THROTTLE_DEADLINE_GUARD_S=90
MEDIA_WORKER_MATERIALIZATION_CPU_THREAD_LIMIT=4
MEDIA_WORKER_FFMPEG_X264_PRESET=ultrafast
EVIDENCE_FINAL_ROOT_MAX_BYTES=0
EVIDENCE_INCOMING_ROOT_MAX_BYTES=0
REPLAY_SINK_OUTPUT_MAX_BYTES=0
EVIDENCE_STORAGE_WARNING_RATIO=0.80
EVIDENCE_STORAGE_CRITICAL_RATIO=0.90
EVIDENCE_STORAGE_HARD_RATIO=1.00
MEDIA_WORKER_CLEANUP_REPLAY_SINK_OUTPUT_ENABLED=true
MEDIA_WORKER_CLEANUP_REPLAY_SINK_OUTPUT_STATUSES=ready,generated,generated_unverified,generated_annotation_failed,duration_guard_failed,generated_corrupt,failed
FRAME_CACHE_SIDECAR_MAX_EVENTS_PER_RUN=100
FRAME_CACHE_SIDECAR_LOOKBACK_COUNT=20000
FRAME_CACHE_SIDECAR_RANGE_COUNT=2000
FRAME_CACHE_SIDECAR_MAX_SCAN=20000
FRAME_CACHE_SIDECAR_STREAM_SESSION_FILTER_MODE=event_window
POST_SAVANT_FAST_RAW_CLIP_ENABLED=true

ROLLING_CACHE_ENABLED=false
ROLLING_CACHE_MATERIALIZATION_ENABLED=false
ROLLING_CACHE_SOURCES=
ROLLING_CACHE_ROOT=/media/rolling-cache
ROLLING_CACHE_MATERIALIZED_ROOT=/media/rolling-cache-materialized
# Must outlive an accepted task, not just its deadline: a task can be claimed
# just before the 300s business deadline and then read source segments for the
# full 120s processing deadline, reaching back pre_seconds before the event.
# 5 + 300 + 120 = 425s required; 600 leaves 175s of margin. Pinned by
# harness/tests/test_evidence_runtime_config_safety.py.
ROLLING_CACHE_RETENTION_SECONDS=600
ROLLING_CACHE_SEGMENT_SECONDS=4
ROLLING_CACHE_PUBLICATION_WORKERS=1
ROLLING_CACHE_PUBLICATION_COMMIT_SLOTS=0
ROLLING_CACHE_PUBLICATION_FINAL_PARENT_GROUP_LIMIT=1
ROLLING_CACHE_PUBLICATION_FILE_SYNC_MODE=fsync
ROLLING_CACHE_PUBLICATION_METADATA_LAYOUT=split
ROLLING_CACHE_FPS=24
ROLLING_CACHE_SEGMENT_FRAMES=
ROLLING_CACHE_MAX_BYTES=0
ROLLING_CACHE_CLEANUP_INTERVAL_SECONDS=30
ROLLING_CACHE_READ_PIN_TTL_SECONDS=600
ROLLING_CACHE_MAINTENANCE_STABILITY_AGE_SECONDS=5
ROLLING_CACHE_FALLBACK_TO_REPLAY=true
ROLLING_CACHE_MATERIALIZATION_MAX_PER_POLL=16
ROLLING_CACHE_MATERIALIZATION_WORKERS=1
ROLLING_CACHE_SUPPRESS_RECORD_REQUESTS=false
EVIDENCE_EVENT_COVERAGE_MERGE_ENABLED=false
EVIDENCE_EVENT_COVERAGE_WINDOW_SECONDS=60
EVIDENCE_EVENT_COVERAGE_EVENT_TYPES=intrusion,watchlist_hit,live_search_hit
EVIDENCE_COVERAGE_PARENT_MAX_DURATION_SECONDS=60

WATCHLIST_MATCH_ENABLED=true
WATCHLIST_THRESHOLD=0.60
WATCHLIST_TARGET_EXTERNAL_PERSON_IDS=demo:midterm:reese,demo:midterm:finch
WATCHLIST_TARGET_NAMES=Reese,Finch
FACE_VECTOR_BACKEND=pgvector
FACE_VECTOR_SMALL_TARGET_THRESHOLD=5
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=face_gallery_current
QDRANT_BASE_COLLECTION=face_gallery_adaface_512_v1
QDRANT_PREFER_GRPC=true
QDRANT_TIMEOUT_SECONDS=2.0
QDRANT_SEARCH_EF=128
QDRANT_CANDIDATE_MULTIPLIER=3
QDRANT_MIN_CANDIDATES=20
QDRANT_EXACT_RERANK_ENABLED=true
QDRANT_FALLBACK_TO_PGVECTOR=true
QDRANT_WRITE_WAIT=true
QDRANT_INDEXING_THRESHOLD_KB=1000
QDRANT_FULL_SCAN_THRESHOLD_KB=1000
QDRANT_DEFAULT_SEGMENT_NUMBER=2
QDRANT_HNSW_M=16
QDRANT_HNSW_EF_CONSTRUCT=100
QDRANT_BATCH_QUERY_ENABLED=false
QDRANT_SYNC_BATCH_SIZE=500
QDRANT_SYNC_MAX_ATTEMPTS=8
QDRANT_SYNC_POLL_INTERVAL_SECONDS=2.0
QDRANT_SYNC_PROCESSING_TIMEOUT_SECONDS=300

EVIDENCE_VERSION=midterm
EVIDENCE_SCHEMA_VERSION=2.0-midterm
EVIDENCE_INCLUDE_LEGACY_METADATA_FIELDS=false
EVIDENCE_MAX_DURATION_SLACK_SEC=10
RAW_CLIP_SANITIZE_MODE=auto
