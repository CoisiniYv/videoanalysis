RTSP_TRANSPORT=tcp,use_wallclock_as_timestamps=1,fflags=+genpts
VIDEO_ANALYTICS_RTSP_URI=rtsp://192.168.1.105:8554/live/1080movie
SAVANT_MODULE_FILE=module.yml
