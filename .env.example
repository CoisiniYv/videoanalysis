# PostgreSQL
POSTGRES_DB=video_analytics
POSTGRES_USER=video
POSTGRES_PASSWORD=video

# Redis
REDIS_URL=redis://redis:6379/0

# Database
DATABASE_URL=postgresql://video:video@postgres:5432/video_analytics

# API
API_PORT=8000

# Redis port
REDIS_PORT=6379

# PostgreSQL port
POSTGRES_PORT=5432

# Heartbeat
HEARTBEAT_INTERVAL_SECONDS=10
